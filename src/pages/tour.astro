---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlitchText from '../components/GlitchText.astro';
import ShowCard from '../components/ShowCard.astro';
import shows from '../data/shows.json';

const now = new Date();
const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

const sortedShows = [...shows].sort(
  (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()
);

const upcomingShows = sortedShows.filter(
  (show) => new Date(show.date + 'T00:00:00') >= today
);

const pastShows = sortedShows
  .filter((show) => new Date(show.date + 'T00:00:00') < today)
  .reverse();
---

<BaseLayout title="Tour" description="Catch Loud Life live. Upcoming shows, tour dates, and tickets.">
  <!-- Tour Hero -->
  <section class="relative pt-32 pb-16 md:pt-40 md:pb-24 flex items-center justify-center overflow-hidden">
    <img
      src="/images/women_octopus.avif"
      alt=""
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#1a0020]/70 via-[var(--color-bg-primary)]/60 to-[var(--color-bg-primary)]"></div>
    <div class="relative z-10 text-center px-4">
      <GlitchText
        text="LOUD LIFE LIVE!"
        tag="h1"
        class="text-4xl sm:text-5xl md:text-7xl font-black text-[var(--color-text-bright)] mb-4"
      />
      <p class="text-lg text-[var(--color-neon-pink)] tracking-widest uppercase">
        Catch us in the pit.
      </p>
    </div>
  </section>

  <!-- Upcoming Shows -->
  <section class="py-12 md:py-20 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <h2 class="font-[family-name:var(--font-heading)] text-2xl md:text-3xl font-bold neon-underline mb-10">
      Upcoming Shows
    </h2>

    {upcomingShows.length > 0 ? (
      <div class="flex flex-col gap-4">
        {upcomingShows.map((show) => (
          <ShowCard
            date={show.date}
            venue={show.venue}
            city={show.city}
            state={show.state}
            ticketUrl={show.ticketUrl}
            note={show.note}
            isPast={false}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-12 border border-[var(--color-bg-card)] bg-[var(--color-bg-secondary)]">
        <p class="text-[var(--color-text-muted)] text-lg mb-2">No shows announced yet.</p>
        <p class="text-[var(--color-text-muted)] text-sm">Follow us on socials for updates.</p>
      </div>
    )}
  </section>

  <!-- Past Shows -->
  {pastShows.length > 0 && (
    <section class="pb-16 md:pb-24 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <h2 class="font-[family-name:var(--font-heading)] text-xl md:text-2xl font-bold text-[var(--color-text-muted)] mb-8">
        Past Shows
      </h2>
      <div class="flex flex-col gap-3">
        {pastShows.map((show) => (
          <ShowCard
            date={show.date}
            venue={show.venue}
            city={show.city}
            state={show.state}
            ticketUrl={show.ticketUrl}
            note={show.note}
            isPast={true}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
