---
interface Props {
  title: string;
  embedUrl: string;
  platform: string;
}

const { title, embedUrl, platform } = Astro.props;

const height = platform === 'spotify' ? '152' : '166';
---

<div class="group">
  <div class="embed-container border border-[var(--color-bg-card)] hover:border-[var(--color-neon-pink)] transition-colors duration-300 hover:shadow-[0_0_15px_var(--color-neon-pink-glow)]">
    <iframe
      src={embedUrl}
      width="100%"
      height={height}
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
      title={title}
    ></iframe>
  </div>
  <p class="mt-2 text-sm text-[var(--color-text-muted)] group-hover:text-[var(--color-neon-pink)] transition-colors">
    {title}
  </p>
</div>
