---
---

<div class="max-w-lg mx-auto">
  <div class="text-center mb-3 md:mb-4">
    <h3 class="font-[family-name:var(--font-heading)] text-xs sm:text-sm uppercase tracking-widest text-[var(--color-text-muted)] mb-1">
      Neon Icons Pinball
    </h3>
    <p class="text-[10px] sm:text-xs text-[var(--color-text-muted)] mb-2">Dystopian Bay Area Edition</p>
    <div class="flex items-center justify-center gap-6 text-xs sm:text-sm">
      <span class="text-[var(--color-text-muted)]">Score: <span id="pinball-score" class="text-[var(--color-neon-pink)] font-bold">0</span></span>
    </div>
  </div>

  <div id="pinball-container" class="border border-[var(--color-bg-card)] hover:border-[var(--color-neon-pink)] transition-colors flex justify-center overflow-hidden"></div>

  <!-- Touch controls for mobile -->
  <div class="flex md:hidden mt-3 gap-3">
    <button id="flipper-left-btn" class="flex-1 neon-btn text-xs py-4 select-none active:bg-[var(--color-neon-pink)] active:text-[var(--color-bg-primary)]" aria-label="Left flipper">
      LEFT
    </button>
    <button id="flipper-right-btn" class="flex-1 neon-btn text-xs py-4 select-none active:bg-[var(--color-neon-pink)] active:text-[var(--color-bg-primary)]" aria-label="Right flipper">
      RIGHT
    </button>
  </div>

  <div class="mt-2 md:mt-3 flex items-center justify-between text-[10px] sm:text-xs text-[var(--color-text-muted)]">
    <span class="hidden md:inline">Left/Right arrows: Flippers &nbsp; Enter: Pause</span>
    <span class="md:hidden">Tap buttons to flip</span>
    <span class="uppercase tracking-wider">MIT License</span>
  </div>
</div>

<script>
  import p5 from 'p5';
  import planck from 'planck-js';

  // Constants
  const PX2M = 0.01;
  const THICKNESS = 10;
  const FPS = 60;
  const BASE_W = 480;
  const BASE_H = 480;

  // Responsive canvas size
  const containerEl = document.getElementById('pinball-container')!;
  const maxWidth = Math.min(containerEl.clientWidth, BASE_W);
  const SCALE = maxWidth / BASE_W;
  const CANVAS_W = Math.floor(BASE_W * SCALE);
  const CANVAS_H = Math.floor(BASE_H * SCALE);

  // Cyberpunk theme colors
  const COLORS = {
    bg: '#0a0a0f',
    ball: '#00f0ff',
    ballGlow: 'rgba(0, 240, 255, 0.3)',
    flipper: '#ff2d95',
    flipperGlow: 'rgba(255, 45, 149, 0.3)',
    bumperDefault: '#1a1a2e',
    bumperBorder: '#ff2d95',
    bumperHit: '#ff2d95',
    bumperGlow: 'rgba(255, 45, 149, 0.5)',
    wall: '#1a1a2e',
    wallStroke: 'rgba(255, 45, 149, 0.2)',
    gridLine: 'rgba(255, 45, 149, 0.04)',
    text: '#e0e0e0',
    pink: '#ff2d95',
    cyan: '#00f0ff',
    purple: '#b829dd',
  };

  // Bumper labels themed to Loud Life universe
  const BUMPER_LABELS = ['LL', 'R', 'NI', 'FB', 'VB'];

  // Touch state
  let touchLeft = false;
  let touchRight = false;

  // ===== BALL CLASS =====
  class Ball {
    p: any;
    body: any;
    radius: number;

    constructor(p: any, world: any, x: number, y: number) {
      this.p = p;
      this.radius = 7 * SCALE;
      const position = planck.Vec2(x * SCALE * PX2M, y * SCALE * PX2M);
      this.body = world.createDynamicBody({ position, bullet: true });
      this.body.createFixture(planck.Circle(this.radius * PX2M), {
        density: 1.0,
        restitution: 0.1,
        userData: { label: 'ball' },
      });
    }

    draw() {
      const pos = this.body.getPosition();
      const x = pos.x / PX2M;
      const y = pos.y / PX2M;

      // Glow effect
      this.p.noStroke();
      this.p.fill(COLORS.ballGlow);
      this.p.circle(x, y, this.radius * 4);

      // Ball
      this.p.fill(COLORS.ball);
      this.p.circle(x, y, this.radius * 2);

      // Inner highlight
      this.p.fill('rgba(255, 255, 255, 0.5)');
      this.p.circle(x - 1.5 * SCALE, y - 1.5 * SCALE, 4 * SCALE);
    }

    limitSpeed() {
      const vel = this.body.getLinearVelocity();
      const maxSpeed = 3.0;
      const clampedX = Math.max(-maxSpeed, Math.min(maxSpeed, vel.x));
      const clampedY = Math.max(-maxSpeed, Math.min(maxSpeed, vel.y));
      this.body.setLinearVelocity(planck.Vec2(clampedX, clampedY));
    }
  }

  // ===== BUMPER CLASS =====
  class Bumper {
    p: any;
    body: any;
    radius: number;
    color: string;
    label: string;
    hitTimer: number;

    constructor(p: any, world: any, x: number, y: number, label: string) {
      this.p = p;
      this.radius = 25 * SCALE;
      this.color = COLORS.bumperDefault;
      this.label = label;
      this.hitTimer = 0;
      const position = planck.Vec2(x * SCALE * PX2M, y * SCALE * PX2M);
      this.body = world.createBody({ type: 'static', position });
      this.body.createFixture(planck.Circle(this.radius * PX2M), {
        density: 1.0,
        friction: 0.0,
        restitution: 1.0,
        userData: { label: `bumper-${label}` },
      });
    }

    draw() {
      const pos = this.body.getPosition();
      const x = pos.x / PX2M;
      const y = pos.y / PX2M;
      const isHit = this.hitTimer > 0;

      if (isHit) this.hitTimer--;

      // Glow when hit
      if (isHit) {
        this.p.noStroke();
        this.p.fill(COLORS.bumperGlow);
        this.p.circle(x, y, this.radius * 3.5);
      }

      // Bumper body
      this.p.fill(isHit ? COLORS.bumperHit : COLORS.bumperDefault);
      this.p.stroke(isHit ? COLORS.bumperHit : COLORS.bumperBorder + '66');
      this.p.strokeWeight(2 * SCALE);
      this.p.circle(x, y, this.radius * 2);

      // Label
      this.p.noStroke();
      this.p.fill(isHit ? COLORS.bg : COLORS.text);
      this.p.textAlign(this.p.CENTER, this.p.CENTER);
      this.p.textSize(this.radius * 0.6);
      this.p.textFont('Orbitron, Arial Black, sans-serif');
      this.p.text(this.label, x, y);
    }

    collide() {
      this.color = COLORS.bumperHit;
      this.hitTimer = 8;
    }
  }

  // ===== FLIPPER CLASS =====
  class Flipper {
    p: any;
    world: any;
    bodyLeft: any;
    bodyRight: any;
    jointLeft: any;
    jointRight: any;
    w: number;
    h: number;

    constructor(p: any, world: any, wallBottomLeft: any, wallBottomRight: any, canvas: any) {
      this.p = p;
      this.world = world;
      this.w = canvas.width / 6 - THICKNESS * SCALE;
      this.h = THICKNESS * SCALE;

      const yPos = canvas.height - this.h / 2;

      // Left flipper
      const posLeft = planck.Vec2(
        (canvas.width / 2 - this.w / 2 - THICKNESS * SCALE) * PX2M,
        yPos * PX2M
      );
      this.bodyLeft = world.createDynamicBody({ position: posLeft });
      this.bodyLeft.createFixture(
        planck.Box(
          (this.w / 2) * PX2M,
          (this.h / 2) * PX2M,
          planck.Vec2(0, 0),
          0
        ),
        { density: 1.0, userData: { label: 'flipper-left' } }
      );

      const anchorLeft = planck.Vec2(
        (canvas.width / 2 - this.w - THICKNESS * SCALE) * PX2M,
        yPos * PX2M
      );
      this.jointLeft = planck.RevoluteJoint(
        {
          enableMotor: true,
          maxMotorTorque: 10,
          enableLimit: true,
          lowerAngle: (-20 * Math.PI) / 180,
          upperAngle: (5 * Math.PI) / 180,
        },
        wallBottomLeft,
        this.bodyLeft,
        anchorLeft
      );
      world.createJoint(this.jointLeft);

      // Right flipper
      const posRight = planck.Vec2(
        (canvas.width / 2 + this.w / 2 + THICKNESS * SCALE) * PX2M,
        yPos * PX2M
      );
      this.bodyRight = world.createDynamicBody({ position: posRight });
      this.bodyRight.createFixture(
        planck.Box(
          (this.w / 2) * PX2M,
          (this.h / 2) * PX2M,
          planck.Vec2(0, 0),
          0
        ),
        { density: 1.0, userData: { label: 'flipper-right' } }
      );

      const anchorRight = planck.Vec2(
        (canvas.width / 2 + this.w + THICKNESS * SCALE) * PX2M,
        yPos * PX2M
      );
      this.jointRight = planck.RevoluteJoint(
        {
          enableMotor: true,
          maxMotorTorque: 10,
          enableLimit: true,
          lowerAngle: (-5 * Math.PI) / 180,
          upperAngle: (20 * Math.PI) / 180,
        },
        wallBottomRight,
        this.bodyRight,
        anchorRight
      );
      world.createJoint(this.jointRight);
    }

    draw() {
      this.drawSingle(this.bodyLeft, this.jointLeft);
      this.drawSingle(this.bodyRight, this.jointRight);
    }

    drawSingle(body: any, joint: any) {
      const fixture = body.getFixtureList();
      const shape = fixture.getShape();
      const vertices = shape.m_vertices;
      const centroid = shape.m_centroid;
      const angle = body.getAngle();

      this.p.push();
      this.p.translate(centroid.x / PX2M, centroid.y / PX2M);
      this.p.rotate(angle);

      // Glow
      this.p.noStroke();
      this.p.fill(COLORS.flipperGlow);
      this.p.rect(0, 0, this.w + 6 * SCALE, this.h + 6 * SCALE, 3);

      // Flipper body
      this.p.fill(COLORS.flipper);
      this.p.noStroke();
      this.p.beginShape();
      for (const v of vertices) {
        this.p.vertex((v.x - centroid.x) / PX2M, (v.y - centroid.y) / PX2M);
      }
      this.p.endShape(this.p.CLOSE);
      this.p.pop();
    }

    rotateLeft() { this.jointLeft.setMotorSpeed(-20); }
    resetLeft() { this.jointLeft.setMotorSpeed(20); }
    rotateRight() { this.jointRight.setMotorSpeed(20); }
    resetRight() { this.jointRight.setMotorSpeed(-20); }
  }

  // ===== WALLS CLASS =====
  class Walls {
    p: any;
    bodies: any[];
    wallBottomLeft: any;
    wallBottomRight: any;

    constructor(p: any, world: any, canvas: any) {
      this.p = p;
      this.bodies = [];

      const w = canvas.width;
      const h = canvas.height;
      const t = THICKNESS * SCALE;

      // Top wall
      this.addWall(world, w / 2, t / 2, w, t, 0);

      // Bottom-left angled wall
      const blW = (w / 6) / Math.cos(Math.PI / 4);
      this.wallBottomLeft = this.addWall(
        world,
        w / 6 / 2,
        h - w / 6 / 2,
        blW, t,
        Math.PI / 4
      );

      // Bottom-right angled wall
      const brW = (w / 6) / Math.cos(-Math.PI / 4);
      this.wallBottomRight = this.addWall(
        world,
        w - w / 6 / 2,
        h - w / 6 / 2,
        brW, t,
        -Math.PI / 4
      );

      // Left wall
      this.addWall(world, t / 2, h / 3, t, (h / 3) * 2, 0);

      // Right wall
      this.addWall(world, w - t / 2, h / 3, t, (h / 3) * 2, 0);
    }

    addWall(world: any, x: number, y: number, w: number, h: number, angle: number) {
      const body = world.createBody({ type: 'static' });
      body.createFixture(
        planck.Box(
          (w / 2) * PX2M,
          (h / 2) * PX2M,
          planck.Vec2(x * PX2M, y * PX2M),
          angle
        ),
        { density: 1.0, friction: 0.0, userData: { label: 'wall' } }
      );
      this.bodies.push(body);
      return body;
    }

    draw() {
      for (const body of this.bodies) {
        const fixture = body.getFixtureList();
        const shape = fixture.getShape();
        const vertices = shape.m_vertices;
        const centroid = shape.m_centroid;
        const angle = body.getAngle();

        this.p.push();
        this.p.translate(centroid.x / PX2M, centroid.y / PX2M);
        this.p.rotate(angle);

        this.p.fill(COLORS.wall);
        this.p.stroke(COLORS.wallStroke);
        this.p.strokeWeight(1);
        this.p.beginShape();
        for (const v of vertices) {
          this.p.vertex((v.x - centroid.x) / PX2M, (v.y - centroid.y) / PX2M);
        }
        this.p.endShape(this.p.CLOSE);
        this.p.pop();
      }
    }
  }

  // ===== MAIN GAME =====
  const scoreEl = document.getElementById('pinball-score')!;
  const container = document.getElementById('pinball-container')!;

  // Touch control buttons
  const leftBtn = document.getElementById('flipper-left-btn');
  const rightBtn = document.getElementById('flipper-right-btn');

  if (leftBtn) {
    leftBtn.addEventListener('touchstart', (e) => { e.preventDefault(); touchLeft = true; }, { passive: false });
    leftBtn.addEventListener('touchend', (e) => { e.preventDefault(); touchLeft = false; }, { passive: false });
    leftBtn.addEventListener('touchcancel', () => { touchLeft = false; });
    leftBtn.addEventListener('mousedown', () => { touchLeft = true; });
    leftBtn.addEventListener('mouseup', () => { touchLeft = false; });
    leftBtn.addEventListener('mouseleave', () => { touchLeft = false; });
  }
  if (rightBtn) {
    rightBtn.addEventListener('touchstart', (e) => { e.preventDefault(); touchRight = true; }, { passive: false });
    rightBtn.addEventListener('touchend', (e) => { e.preventDefault(); touchRight = false; }, { passive: false });
    rightBtn.addEventListener('touchcancel', () => { touchRight = false; });
    rightBtn.addEventListener('mousedown', () => { touchRight = true; });
    rightBtn.addEventListener('mouseup', () => { touchRight = false; });
    rightBtn.addEventListener('mouseleave', () => { touchRight = false; });
  }

  const sketch = (p: any) => {
    let world: any;
    let walls: Walls;
    let flipper: Flipper;
    let ball: Ball;
    let bumpers: Bumper[] = [];
    let score = 0;
    let isPaused = false;

    const canvasSize = { width: CANVAS_W, height: CANVAS_H };

    p.setup = () => {
      const cnv = p.createCanvas(CANVAS_W, CANVAS_H + 20 * SCALE);
      cnv.parent(container);
      p.rectMode(p.CENTER);
      p.angleMode(p.RADIANS);
      p.frameRate(FPS);
      p.textFont('Share Tech Mono, Courier New, monospace');

      world = planck.World({ gravity: planck.Vec2(0, 10) });

      walls = new Walls(p, world, canvasSize);
      flipper = new Flipper(p, world, walls.wallBottomLeft, walls.wallBottomRight, canvasSize);
      ball = new Ball(p, world, 200, 10);

      // Themed bumpers
      bumpers = [
        new Bumper(p, world, 100, 120, BUMPER_LABELS[0]),
        new Bumper(p, world, 240, 120, BUMPER_LABELS[1]),
        new Bumper(p, world, 380, 120, BUMPER_LABELS[2]),
        new Bumper(p, world, 170, 210, BUMPER_LABELS[3]),
        new Bumper(p, world, 310, 210, BUMPER_LABELS[4]),
      ];

      // Collision handling
      world.on('post-solve', (contact: any) => {
        const fA = contact.getFixtureA();
        const fB = contact.getFixtureB();

        if (!fA || !fB) return;
        const udA = fA.getUserData();
        const udB = fB.getUserData();
        if (!udA || !udB) return;
        const labelA = udA.label || '';
        const labelB = udB.label || '';

        const isBallA = labelA === 'ball';
        const isBallB = labelB === 'ball';
        if (!isBallA && !isBallB) return;

        const otherLabel = isBallA ? labelB : labelA;

        if (otherLabel.startsWith('bumper-')) {
          for (const bumper of bumpers) {
            if (`bumper-${bumper.label}` === otherLabel) {
              bumper.collide();
              score++;
              scoreEl.textContent = String(score);
              ball.limitSpeed();
              break;
            }
          }
        }
      });
    };

    p.draw = () => {
      if (isPaused) return;

      world.step(1 / FPS);

      // Background
      p.background(COLORS.bg);

      // Subtle grid
      p.stroke(COLORS.gridLine);
      p.strokeWeight(1);
      for (let x = 0; x < CANVAS_W; x += 40 * SCALE) {
        p.line(x, 0, x, CANVAS_H);
      }
      for (let y = 0; y < CANVAS_H; y += 40 * SCALE) {
        p.line(0, y, CANVAS_W, y);
      }

      // Faint title
      p.noStroke();
      p.fill('rgba(255, 45, 149, 0.08)');
      p.textAlign(p.CENTER, p.CENTER);
      p.textSize(20 * SCALE);
      p.textFont('Orbitron, Arial Black, sans-serif');
      p.text('LOUD LIFE', CANVAS_W / 2, 50 * SCALE);

      // Draw game objects
      walls.draw();
      flipper.draw();
      ball.draw();
      for (const bumper of bumpers) {
        bumper.draw();
      }

      // Score bar at bottom
      p.fill(COLORS.bg);
      p.noStroke();
      p.rect(CANVAS_W / 2, CANVAS_H + 10 * SCALE, CANVAS_W, 20 * SCALE);
      p.fill(COLORS.pink);
      p.textSize(12 * SCALE);
      p.textFont('Share Tech Mono, Courier New, monospace');
      p.textAlign(p.CENTER, p.CENTER);
      p.text(`SCORE: ${score}`, CANVAS_W / 2, CANVAS_H + 10 * SCALE);

      // Handle flipper input (keyboard + touch)
      if (p.keyIsDown(p.LEFT_ARROW) || touchLeft) {
        flipper.rotateLeft();
      } else {
        flipper.resetLeft();
      }

      if (p.keyIsDown(p.RIGHT_ARROW) || touchRight) {
        flipper.rotateRight();
      } else {
        flipper.resetRight();
      }
    };

    p.keyPressed = () => {
      if (p.keyCode === p.ENTER) {
        isPaused = !isPaused;
      }
    };
  };

  // Initialize p5 in instance mode
  new p5(sketch);
</script>
