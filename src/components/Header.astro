---
import site from '../data/site.json';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/tour', label: 'Tour' },
  { href: '/blog/my-guitar-is-janky-but-its-got-heart', label: 'Blog' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[var(--color-bg-primary)]/90 backdrop-blur-sm border-b border-[var(--color-bg-card)]">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="font-[family-name:var(--font-heading)] text-xl font-bold tracking-wider text-[var(--color-neon-pink)] hover:opacity-80 transition-opacity">
      {site.bandName}
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'font-[family-name:var(--font-body)] text-sm uppercase tracking-widest transition-colors',
              currentPath === link.href
                ? 'text-[var(--color-neon-pink)]'
                : 'text-[var(--color-text-primary)] hover:text-[var(--color-neon-pink)]',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="block w-6 h-0.5 bg-[var(--color-neon-pink)] transition-transform" id="bar1"></span>
      <span class="block w-6 h-0.5 bg-[var(--color-neon-pink)] transition-opacity" id="bar2"></span>
      <span class="block w-6 h-0.5 bg-[var(--color-neon-pink)] transition-transform" id="bar3"></span>
    </button>
  </nav>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="hidden md:hidden fixed inset-0 top-16 bg-[var(--color-bg-primary)]/95 backdrop-blur-md z-40"
  >
    <ul class="flex flex-col items-center justify-center h-full gap-10">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'font-[family-name:var(--font-heading)] text-2xl uppercase tracking-widest transition-colors',
              currentPath === link.href
                ? 'text-[var(--color-neon-pink)] neon-text'
                : 'text-[var(--color-text-primary)] hover:text-[var(--color-neon-pink)]',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');

  if (toggle && menu && bar1 && bar2 && bar3) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');

      if (isOpen) {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        bar1.style.transform = '';
        bar2.style.opacity = '';
        bar3.style.transform = '';
      } else {
        menu.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        bar1.style.transform = 'rotate(45deg) translate(4px, 4px)';
        bar2.style.opacity = '0';
        bar3.style.transform = 'rotate(-45deg) translate(4px, -4px)';
      }
    });

    // Close menu when clicking a link
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        bar1.style.transform = '';
        bar2.style.opacity = '';
        bar3.style.transform = '';
      });
    });
  }
</script>
