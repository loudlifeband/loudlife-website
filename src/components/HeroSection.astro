---
import GlitchText from './GlitchText.astro';
import site from '../data/site.json';
---

<section class="relative min-h-[100svh] flex items-center justify-center overflow-hidden">
  <!-- Background image -->
  <img
    src="/images/background_image.avif"
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
  />
  <!-- Dark overlay for readability -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#1a0020]/70 via-[var(--color-bg-primary)]/60 to-[var(--color-bg-primary)]"></div>

  <!-- Animated grid lines -->
  <div class="absolute inset-0 opacity-10"
    style="background-image: linear-gradient(var(--color-neon-pink) 1px, transparent 1px), linear-gradient(90deg, var(--color-neon-pink) 1px, transparent 1px); background-size: 40px 40px;">
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 pt-14">
    <GlitchText
      text={site.bandName}
      tag="h1"
      class="text-4xl sm:text-6xl md:text-8xl lg:text-9xl font-black text-[var(--color-text-bright)] mb-4 md:mb-6"
    />

    <p class="text-sm sm:text-lg md:text-2xl text-[var(--color-neon-pink)] font-[family-name:var(--font-body)] mb-2 md:mb-3 tracking-widest uppercase">
      {site.tagline}
    </p>
    <p class="text-xs sm:text-sm text-[var(--color-text-muted)] font-[family-name:var(--font-body)] mb-8 md:mb-12 tracking-wider">
      From the dystopian Bay Area underground
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
      <a href="#music" class="neon-btn-filled text-sm w-full sm:w-auto">
        Listen Now
      </a>
      <a href="/tour" class="neon-btn text-sm w-full sm:w-auto">
        See Us Live
      </a>
    </div>
  </div>

  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-24 md:h-32 bg-gradient-to-t from-[var(--color-bg-primary)] to-transparent"></div>
</section>
